import json
from pathlib import Path

FIN_DIR = Path("data/financials")
index = {}
for sym_dir in sorted(FIN_DIR.iterdir()):
    if not sym_dir.is_dir():
        continue
    periods = sorted(f.stem for f in sym_dir.glob("*.json") if f.stem != "index")
    if periods:
        index[sym_dir.name] = periods

with open(FIN_DIR / "index.json", "w", encoding="utf-8") as f:
    json.dump(index, f, ensure_ascii=False, indent=2)

print(json.dumps(index, ensure_ascii=False, indent=2))
